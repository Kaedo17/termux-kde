#!/data/data/com.termux/files/usr/bin/bash
# chroot-umount - Unmount chroot filesystems
ROOTFS="/data/data/com.termux/files/usr/var/lib/proot-distro/containers/ubuntu/rootfs"
echo "Unmounting chroot filesystems..."
su -c "umount $ROOTFS/dev/pts" 2>/dev/null
su -c "umount $ROOTFS/dev" 2>/dev/null
su -c "umount $ROOTFS/sys" 2>/dev/null
su -c "umount $ROOTFS/proc" 2>/dev/null
su -c "umount $ROOTFS/tmp" 2>/dev/null
echo "Done."
